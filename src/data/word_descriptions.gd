## 玩家短说明由 BattleText 绑定当前参数；上面的原文只供内容工具留档。
static func brief(word: WordData) -> String:
	return BattleText.word(word, true)

static func apply_to(word: WordData) -> void:
	if not TEXT.has(word.word):
		return
	word.description = TEXT[word.word]
	word.effect_summary = TEXT[word.word]
	if EFFECT_NOTES.has(word.word):
		var notes: Array = EFFECT_NOTES[word.word]
		for i in mini(notes.size(), word.effects.size()):
			word.effects[i].note = notes[i]
	elif word.effects.size() == 1:
		word.effects[0].note = TEXT[word.word]
